{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue69 mode E private synthetic event record",
  "description": "May contain synthetic coordinates; exporter permits ignored captures/ only. Not a public trajectory artifact.",
  "type": "object",
  "required": ["dataset_source","simulation_engine","upstream_sha","scenario_seed","source_run_id","observer_regime","event_id","observed_value","rx_status","detector_id","score","threshold","decision"],
  "properties": {
    "dataset_source": {"const":"simulation"},
    "simulation_engine": {"const":"OMNeT++/INET"},
    "upstream_sha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "scenario_seed": {"type":"integer"},
    "source_run_id": {"type":"string","minLength":1},
    "observer_regime": {"enum":["async_single_packet_per_observation","same_physical_packet_multirx"]},
    "event_id": {"type":"integer"},
    "observed_value": {"type":["number","null"]},
    "rx_status": {"enum":["received","not_delivered","missing_signal_power"]},
    "score": {"type":["number","null"]},
    "threshold": {"type":["number","null"]},
    "decision": {"enum":["FLAG","BELOW_THRESHOLD","UNDETERMINED"]}
  }
}
